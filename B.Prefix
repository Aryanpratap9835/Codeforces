#include <bits/stdc++.h>
using namespace std;
#define int long long
signed main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	int n;
	cin>>n;
	vector<int>a(n);
	for(auto &it:a)cin>>it;
	int l=0;int h=0;
	int ans=a[0];
	for(int i=0;i<n;i++){
	    ans=max({ans,a[i]+h,a[i]-l});
	    l=min({a[i]+2*l,a[i]});
	    h=max({a[i],a[i]+2*h});
	}
	cout<<ans<<"\n";
	}
}
