#include <bits/stdc++.h>
using namespace std;
#define int long long
signed main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	int n,k;
	cin>>n>>k;
	vector<int>a(n);
	for(auto &it:a)cin>>it;
     int ans=0;
     vector<int>prefix(n+1,0);
     for(int i=0;i<n;i++){
         prefix[i+1]=prefix[i]+a[i];
     }
     map<int,vector<int>>mpp;
     
     int j=0;
    for(int i=0;i<=n;i++){
        mpp[prefix[i]%k].push_back(i);
    }
    for(int i=k+1;i<=n;i++){
        int upper=std::upper_bound(mpp[prefix[i]%k].begin(), mpp[prefix[i]%k].end(), i-k-1)-mpp[prefix[i]%k].begin();
        ans+=upper;
        
    }
     cout<<ans<<"\n";
}
}
