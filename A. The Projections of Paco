#include <bits/stdc++.h>
using namespace std;
#define int long long
signed main(){
    int t;
    cin>>t;
    while(t--){
        int x=0;
        int n;
        cin>>n;
        vector<int>a(n);
        for(auto &it:a)cin>>it;
         int old=0;
        for(int i=n-1;i>=0;i--){
            x=2*a[i]-old;
            old=x;
        }
        cout<<x/2<<"\n";
    }
}
